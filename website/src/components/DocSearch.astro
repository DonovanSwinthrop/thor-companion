---
// The docs' search box: fetches the docs API on first use and searches it in the browser (src/lib/docsearch.js,
// the same engine the app runs). "/" focuses it from anywhere on a docs page; arrows and Enter pick a result.
// On /docs/?q=... it starts with that query (search engines' site search lands there).
import { DOCS_API_PATH } from '../lib/docs.js';

interface Props { big?: boolean; autofocus?: boolean }
const { big = false } = Astro.props;
---
<div class:list={['dsearch', big && 'big']} data-docsearch data-api={DOCS_API_PATH}>
  <label class="dsearch-box f-card">
    <svg class="dsearch-icon" viewBox="0 0 12 12" aria-hidden="true" shape-rendering="crispEdges">
      <path fill="currentColor" d="M3 0h4v1H3zM2 1h1v1H2zM7 1h1v1H7zM1 2h1v4H1zM8 2h1v4H8zM2 6h1v1H2zM7 6h1v1H7zM3 7h4v1H3zM8 7h1v1H8zM9 8h1v1H9zM10 9h1v1h-1zM11 10h1v2h-1z"/>
    </svg>
    <span class="sr-only">Search the docs</span>
    <input type="search" placeholder="Search the docs" autocomplete="off" spellcheck="false" aria-controls="dsearch-results" aria-autocomplete="list" />
    <kbd class="dsearch-kbd" aria-hidden="true">/</kbd>
  </label>
  <ol class="dsearch-results f-card" id="dsearch-results" role="listbox" hidden></ol>
</div>

<style is:global>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .dsearch { position: relative; width: 100%; }
  .dsearch-box { display: flex; align-items: center; gap: 10px; padding: calc(var(--px) * 2) calc(var(--px) * 3); cursor: text; }
  .dsearch-icon { width: calc(var(--px) * 6); height: calc(var(--px) * 6); flex: none; color: var(--muted); }
  .dsearch input {
    flex: 1; min-width: 0; width: 100%; border: 0; outline: 0; background: transparent; color: var(--ink);
    font: 17px/1.4 'Atkinson Hyperlegible', system-ui, sans-serif; padding: 4px 0;
  }
  .dsearch input::-webkit-search-cancel-button { display: none; }
  .dsearch-box:focus-within { outline: var(--px) dashed var(--red); outline-offset: calc(var(--px) * 2); }
  .dsearch-kbd { font-size: var(--t-xs); color: var(--muted); border: var(--px) solid #c9c7d6; padding: 0 6px; line-height: 1.3; }
  .dsearch.big input { font-size: 20px; }
  .dsearch.big .dsearch-box { padding: calc(var(--px) * 4) calc(var(--px) * 5); }
  .dsearch-results {
    position: absolute; z-index: 40; left: 0; right: 0; top: calc(100% + 10px); margin: 0; padding: 6px;
    list-style: none; max-height: min(70vh, 560px); overflow: auto;
  }
  .dsearch-results a { display: block; padding: 10px 12px; text-decoration: none; color: var(--ink); }
  .dsearch-results li[aria-selected='true'] a, .dsearch-results a:hover { background: #fff1bf; }
  .dsearch-where { display: block; font-size: var(--t-xs); color: var(--red); letter-spacing: 0.0625em; }
  .dsearch-title { display: block; font-size: var(--t-s); line-height: 1.2; margin: 2px 0 4px; }
  .dsearch-snip { display: block; font: 15px/1.45 'Atkinson Hyperlegible', system-ui, sans-serif; color: var(--ink-2); }
  .dsearch-snip mark { background: #ffe58a; color: inherit; padding: 0 1px; }
  .dsearch-empty { padding: 12px; font: 16px/1.45 'Atkinson Hyperlegible', system-ui, sans-serif; color: var(--ink-2); }
</style>

<script>
  import { buildIndex, search } from '../lib/docsearch.js';

  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const marked = (text: string, marks: number[][]) => {
    let out = '';
    let at = 0;
    for (const [a, b] of marks) {
      out += esc(text.slice(at, a)) + '<mark>' + esc(text.slice(a, b)) + '</mark>';
      at = b;
    }
    return out + esc(text.slice(at));
  };

  let indexPromise: Promise<any> | null = null;

  for (const root of document.querySelectorAll<HTMLElement>('[data-docsearch]')) {
    const input = root.querySelector('input')!;
    const list = root.querySelector<HTMLOListElement>('.dsearch-results')!;
    const load = () => (indexPromise ??= fetch(root.dataset.api!).then((r) => r.json()).then(buildIndex));
    let selected = -1;

    const select = (i: number) => {
      const items = [...list.querySelectorAll('li[role="option"]')];
      selected = items.length ? (i + items.length) % items.length : -1;
      items.forEach((li, j) => li.setAttribute('aria-selected', String(j === selected)));
      items[selected]?.scrollIntoView({ block: 'nearest' });
    };

    const run = async () => {
      const q = input.value.trim();
      if (!q) { list.hidden = true; return; }
      const index = await load();
      if (input.value.trim() !== q) return;
      const hits = search(index, q, 8);
      list.innerHTML = hits.length
        ? hits.map((h: any) => `
            <li role="option" aria-selected="false">
              <a href="/docs/${h.page}/${h.anchor ? '#' + h.anchor : ''}">
                <span class="dsearch-where">${esc(h.heading ? h.pageTitle.toUpperCase() : 'PAGE')}</span>
                <span class="dsearch-title">${esc(h.heading ?? h.pageTitle)}</span>
                <span class="dsearch-snip">${marked(h.snippet.text, h.snippet.marks)}</span>
              </a>
            </li>`).join('')
        : `<li class="dsearch-empty">Nothing found for “${esc(q)}”. Try a shorter word, or a button or setting name.</li>`;
      list.hidden = false;
      select(hits.length ? 0 : -1);
    };

    input.addEventListener('focus', () => { load(); if (input.value.trim()) run(); });
    input.addEventListener('input', run);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); select(selected + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); select(selected - 1); }
      else if (e.key === 'Enter') {
        const a = list.querySelectorAll<HTMLAnchorElement>('li[role="option"] a')[selected];
        if (a) { e.preventDefault(); location.href = a.href; }
      } else if (e.key === 'Escape') { list.hidden = true; input.blur(); }
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target as Node)) list.hidden = true; });

    const q = new URLSearchParams(location.search).get('q');
    if (q && root.classList.contains('big')) { input.value = q; input.focus(); run(); }
  }

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key !== '/' || t.closest('input, textarea, [contenteditable]')) return;
    const input = document.querySelector<HTMLInputElement>('[data-docsearch] input');
    if (input) { e.preventDefault(); input.focus(); }
  });
</script>
